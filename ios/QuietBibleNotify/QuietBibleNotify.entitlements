<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared by the app, its widget and its notification extension: the
	     circles' names and which have something new (Shared/SharedCircles.swift).
	     A keychain group needs nothing set up at Apple, unlike an App Group. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.myquietbible.ios.shared</string>
	</array>
</dict>
</plist>
