<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own launch screen before the app starts: the
         lamp (no square tile) on leather brown, or on ink in dark mode, the
         same as the splash that follows, so the two read as one. -->
    <style name="LauncherTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/backgroundColor</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
